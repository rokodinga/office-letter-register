# Copy this file to .env.local and replace each value with your Firebase web-app configuration.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Drive Picker
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=

# Server-side Gmail OAuth (never expose these as VITE_ variables)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=https://YOUR-DOMAIN/api/admin/gmail?mode=callback
GMAIL_OAUTH_STATE_SECRET=
# Protects the scheduled Vercel cron endpoint.
CRON_SECRET=
# Firebase Admin service account JSON for Vercel API routes.
FIREBASE_SERVICE_ACCOUNT_JSON=
