{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/public/range-information.js": {
      "includeFiles": "public/data/kodinga-range-information.json.gz.b64"
    }
  },
  "crons": [
    {
      "path": "/api/admin/gmail?mode=sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/admin/gmail-sent?mode=sync",
      "schedule": "15 2 * * *"
    }
  ]
}
