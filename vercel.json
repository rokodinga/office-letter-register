{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/.*|data/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/gmail?mode=sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/admin/gmail-sent?mode=sync",
      "schedule": "15 2 * * *"
    }
  ]
}
