rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator';
    }

    match /users/{userId} {
      // User profiles are provisioned only by the trusted server-side admin API.
      allow create: if false;
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        )
        || (isAdmin() && userId != request.auth.uid)
      );
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /gmailInbox/{messageId} {
      allow read, write: if isAdmin();
    }

    match /gmailSent/{messageId} {
      allow read, write: if isAdmin();
    }

    match /gmailConnections/{connectionId} {
      allow read, write: if false;
    }

    match /incomingLetters/{letterId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /outgoingLetters/{letterId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }
  }
}
