rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'User'
        && request.resource.data.status == 'active';

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        )
        ||
        (
          isAdmin()
          && userId != request.auth.uid
        )
      );

      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Letter registers are readable by every signed-in user, but only
    // active administrators may create, edit, or delete official records.
    match /gmailInbox/{messageId} {
      allow read, write: if isAdmin();
    }

    // Gmail OAuth refresh tokens are server-side only.
    match /gmailConnections/{connectionId} {
      allow read, write: if false;
    }

    match /incomingLetters/{letterId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /outgoingLetters/{letterId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
